<launch>
  <!--
    Static-map localization fragment.

    Loads a pre-built occupancy grid via map_server and starts AMCL on it.
    Intended to be included from higher-level launches (robot_rosa_full.launch,
    test_map.launch) so the map + localization config lives in exactly one place.

    NEVER include this together with gmapping/slam — both would publish /map
    and the map -> odom TF and fight each other.

    Override the map at launch time:
      roslaunch limo_rosa_bridge <parent>.launch \
        map_file:=$(rospack find limo_rosa_bridge)/maps/my_other_map.yaml
  -->

  <arg name="map_file"
       default="$(find limo_rosa_bridge)/maps/limo_lab_map.yaml"
       doc="Absolute path to the .yaml map descriptor consumed by map_server." />
  <arg name="run_global_localization" default="true"
       doc="If true, call /global_localization once after AMCL starts." />
  <arg name="rotate_after_global_localization" default="true"
       doc="If true, rotate once after /global_localization to help AMCL converge." />
  <arg name="rotation_angular_speed" default="0.4"
       doc="In-place localization spin speed in rad/s." />
  <arg name="rotation_duration_s" default="16.0"
       doc="Localization spin duration in seconds (about one turn at defaults)." />

  <!-- Static /map publisher -->
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" />

  <!-- Adaptive Monte Carlo Localization on the static map (publishes map -> odom). -->
  <include file="$(find limo_bringup)/launch/limo_amcl.launch" />

  <!-- Optionally spread AMCL particles over the full map after startup. -->
  <node if="$(arg run_global_localization)"
        pkg="limo_rosa_bridge"
        type="call_global_localization_once.py"
        name="call_global_localization_once"
        output="screen">
    <param name="rotate_after_global" value="$(arg rotate_after_global_localization)" />
    <param name="rotate_angular_speed" value="$(arg rotation_angular_speed)" />
    <param name="rotate_duration_s" value="$(arg rotation_duration_s)" />
  </node>
</launch>
