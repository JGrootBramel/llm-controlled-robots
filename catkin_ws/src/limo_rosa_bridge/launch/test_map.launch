<launch>
  <!-- Backward-compatible entry point: full robot stack lives in robot_rosa_full.launch -->
  <arg name="map_yaml" default="$(find limo_rosa_bridge)/launch/limo_lab_map.yaml" />
  <include file="$(find limo_rosa_bridge)/launch/robot_rosa_full.launch">
    <arg name="map_yaml" value="$(arg map_yaml)" />
  </include>
</launch>
