<launch>
  <!--
    Minimal static-map smoke-test launch.

    Use this to quickly verify that a saved map loads and the robot localizes on it
    (move_base + RViz), without spinning up perception / manipulation. For the full
    ROSA stack on a static map, use robot_rosa_full.launch instead.
  -->

  <arg name="map_file"
       default="$(find limo_rosa_bridge)/maps/limo_lab_map.yaml"
       doc="Absolute path to the .yaml map descriptor used by map_server." />
  <arg name="open_rviz" default="true" doc="Set to false to prevent RViz from launching." />

  <!-- Base + sensors -->
  <include file="$(find limo_bringup)/launch/limo_start.launch" />

  <!-- Static /map + AMCL (shared fragment — keeps this in sync with robot_rosa_full.launch). -->
  <include file="$(find limo_rosa_bridge)/launch/static_map.launch">
    <arg name="map_file" value="$(arg map_file)" />
  </include>

  <!-- Navigation on the static map -->
  <include file="$(find limo_bringup)/launch/limo_move_base.launch" />

  <!-- DaBai U3 RGB-D (the only camera this robot supports). -->
  <include file="$(find astra_camera)/launch/dabai_u3.launch">
    <arg name="enable_depth" value="true" />
    <arg name="depth_align" value="true" />
    <arg name="color_width" value="640" />
    <arg name="color_height" value="480" />
    <arg name="depth_width" value="640" />
    <arg name="depth_height" value="400" />
  </include>

  <!-- Rosbridge so the remote can talk to /map, /amcl_pose, etc. while smoke-testing. -->
  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch" />

  <group if="$(arg open_rviz)">
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find limo_rosa_bridge)/rviz/nav.rviz" required="true" />
  </group>
</launch>
