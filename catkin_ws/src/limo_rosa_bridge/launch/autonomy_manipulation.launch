<launch>
  <!-- Approach (base) + arm control (MyCobot). -->
  <arg name="base_frame" default="base_link" />
  <arg name="map_frame" default="map" />
  <!-- Distance (m) from base_link origin to target when the base parks.
       Cap here is the arm's physical reach (~280 mm from the arm mount).
       Going much above 0.33 will clamp the grasp inside the safe cube and
       the gripper will stop short of the target. Raise ``coord_lim_mm``
       (default 300 mm below) alongside if you push this further. -->
  <arg name="standoff" default="0.20" />
  <arg name="min_standoff" default="0.15" />
  <!-- Smarter close-in: enabled by default, but guarded by front lidar so the
       base stops if something (e.g., the support box) is in front. -->
  <arg name="close_in_enabled" default="true" />
  <arg name="scan_topic" default="/scan" />
  <arg name="close_in_guard_enabled" default="true" />
  <!-- Lowered from 0.35 -> 0.30 so guarded close-in can finish the last ~5 cm
       when the support box is detected but still not in contact range. -->
  <arg name="close_in_guard_distance_m" default="0.20" />
  <arg name="close_in_guard_half_angle_deg" default="18.0" />
  <arg name="close_in_guard_min_valid_beams" default="3" />
  <arg name="close_in_guard_scan_stale_s" default="0.5" />
  <!-- Half-side of the arm's safe Cartesian cube (mm). MyCobot 280 has a
       nominal reach of ~280 mm and a usable max closer to 320 mm, so 300
       is a reasonable headroom bump to pair with the larger standoff. -->
  <arg name="coord_limit_mm" default="300.0" />
  <!-- Base-frame point the IK-derived ready pose aims for. Move this
       forward in lock-step with ``standoff`` so the pre-grasp travel stays
       short once the wrist is pre-oriented. -->
  <arg name="ready_point_base_x_m" default="0.23" />
  <arg name="ready_point_base_y_m" default="0.0" />
  <arg name="ready_point_base_z_m" default="0.15" />
  <arg name="mycobot_port" default="/dev/ttyACM0" />
  <arg name="mycobot_baud" default="115200" />
  <!-- Physical arm mount yaw (CCW degrees from base_link +X to arm +X).
       90 = arm faces robot-left (LIMO Cobot default, gripper swings via
       joint 1 = -90 to face forward at home). Change this if the arm is
       bolted on differently. -->
  <arg name="mount_yaw_deg" default="90.0" />
  <!-- Pre-grasp interpolation mode for send_coords:
       0 = point-to-point joint space (smoothest, no wrist flip; default)
       1 = linear Cartesian (straight-line but only safe once the ready
       pose has pre-oriented the wrist). -->
  <arg name="approach_mode" default="0" />
  <arg name="place_speed" default="40" />
  <arg name="place_gripper_open" default="80" />
  <!-- Optional explicit joint targets for drop/home tuning at the mission
       start pose. Keep six values each (J1..J6). Disabled by default so the
       arm node keeps using mount-aware helper defaults. -->
  <arg name="use_custom_arm_angles" default="false" />
  <arg name="place_angles" default="[-90,-25,-70,7,0,-45]" />
  <arg name="home_angles" default="[-90,0,0,0,0,0]" />
  <!-- Added to arm-frame Z (mm) after map/base_link -> arm mapping. Use when
       /red_cubes/latest_pose has wrong z (e.g. always 0 in map). Typical
       table-top: try 100–200 and tune from grasp logs / reach. -->
  <arg name="grasp_z_adjust_mm" default="140.0" />
  <arg name="target_pose_topic" default="/red_cubes/latest_pose" />
  <!-- One-shot override topic the LLM tools publish to (pick_at_pose etc.).
       Defaults to the arm node's private topic so it works without a remap. -->
  <arg name="target_pose_override_topic" default="/arm_control/target_pose_override" />

  <node pkg="limo_rosa_bridge" type="approach_object_node.py" name="approach_object" output="screen">
    <param name="target_topic" value="$(arg target_pose_topic)" />
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="standoff" value="$(arg standoff)" />
    <param name="min_standoff" value="$(arg min_standoff)" />
    <param name="close_in_enabled" value="$(arg close_in_enabled)" />
    <param name="scan_topic" value="$(arg scan_topic)" />
    <param name="close_in_guard_enabled" value="$(arg close_in_guard_enabled)" />
    <param name="close_in_guard_distance_m" value="$(arg close_in_guard_distance_m)" />
    <param name="close_in_guard_half_angle_deg" value="$(arg close_in_guard_half_angle_deg)" />
    <param name="close_in_guard_min_valid_beams" value="$(arg close_in_guard_min_valid_beams)" />
    <param name="close_in_guard_scan_stale_s" value="$(arg close_in_guard_scan_stale_s)" />
  </node>

  <node pkg="limo_rosa_bridge" type="arm_control_node.py" name="arm_control" output="screen">
    <param name="port" value="$(arg mycobot_port)" />
    <param name="baud" value="$(arg mycobot_baud)" />
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="mount_yaw_deg" value="$(arg mount_yaw_deg)" />
    <param name="approach_mode" value="$(arg approach_mode)" />
    <param name="coord_limit_mm" value="$(arg coord_limit_mm)" />
    <param name="grasp_z_adjust_mm" value="$(arg grasp_z_adjust_mm)" />
    <param name="place_speed" value="$(arg place_speed)" />
    <param name="place_gripper_open" value="$(arg place_gripper_open)" />
    <rosparam if="$(arg use_custom_arm_angles)" param="place_angles" subst_value="true">$(arg place_angles)</rosparam>
    <rosparam if="$(arg use_custom_arm_angles)" param="home_angles" subst_value="true">$(arg home_angles)</rosparam>
    <rosparam param="ready_point_base_xyz_m" subst_value="true">[$(arg ready_point_base_x_m), $(arg ready_point_base_y_m), $(arg ready_point_base_z_m)]</rosparam>
    <!-- Wire the detector's latched pose straight into the arm node. -->
    <remap from="~target_pose" to="$(arg target_pose_topic)" />
    <!-- Explicit one-shot pose (used by ROSA's pick_at_pose tool). -->
    <remap from="~target_pose_override" to="$(arg target_pose_override_topic)" />
  </node>
</launch>
